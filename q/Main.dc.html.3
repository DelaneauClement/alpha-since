      dkTxt: fmtN(S.dk) + ' kg', dkMinus: function () { self.setState({ dk: Math.max(0, S.dk - 2.5) }); }, dkPlus: function () { self.setState({ dk: Math.min(400, S.dk + 2.5) }); },
      barOpts: [20, 15, 10].map(function (bv) { var on = S.bar === bv; return { label: 'Barre ' + bv + ' kg', on: on, bg: on ? '#F2E415' : '#FFFFFF', bd: on ? '#12110C' : '#C9C49A', pick: function () { self.setState({ bar: bv }); } }; }),
      plates: platesV, dkMsg: dkMsg,
      chPhase: phaseTxt, chTime: mm(ch.phase === 'pret' ? S.cw : ch.left), chSerie: 'Série ' + Math.min(ch.serie, S.cs) + ' / ' + S.cs, chBg: chBg, chFg: chFg,
      chStart: chStart, chReset: chReset, chStartLabel: ch.run ? 'Pause' : (ch.phase === 'travail' || ch.phase === 'repos' ? 'Reprendre' : 'Démarrer'),
      cwTxt: S.cw + ' s', cwMinus: function () { setIdle('cw', Math.max(10, S.cw - 5)); }, cwPlus: function () { setIdle('cw', Math.min(300, S.cw + 5)); },
      crTxt: mm(S.cr), crMinus: function () { setIdle('cr', Math.max(15, S.cr - 15)); }, crPlus: function () { setIdle('cr', Math.min(300, S.cr + 15)); },
      csTxt: String(S.cs), csMinus: function () { setIdle('cs', Math.max(1, S.cs - 1)); }, csPlus: function () { setIdle('cs', Math.min(10, S.cs + 1)); },
      mqList: mqList, mqDone: mqDone, mqRes: res, mqReset: function () { self.setState({ mq: {} }); },
      menuOpen: !!this.state.menuOpen, toggleMenu: function () { self.setState({ menuOpen: !self.state.menuOpen }); }, closeMenu: function () { self.setState({ menuOpen: false }); },
      qFood: cur[0], qPos: (qi + 1) + ' / ' + QZ.length, qOpts: qOpts, qAnswered: answered,
      qVerdict: qp === cur[1] ? 'Bien vu !' : 'Raté : ' + rightLabel.toLowerCase(),
      qText: cur[2], qScore: String(qs.qScore || 0), qDone: String(qs.qDone || 0),
      qNextLabel: last ? 'Recommencer le quiz' : 'Aliment suivant',
      qNext: function () { if (last) self.setState({ qi: 0, qp: null, qScore: 0, qDone: 0 }); else self.setState({ qi: qi + 1, qp: null }); },
      plMoods: [['fun', 'Fun', 'Bonne humeur et refrains qu’on chante entre deux séries.'], ['agressif', 'Boost', 'Pour les charges lourdes et les derniers kilomètres.'], ['chill', 'Chill', 'Échauffement, mobilité, footing tranquille.']].map(function (m) { var on = (self.state.plMood || 'fun') === m[0]; return { label: m[1], sub: m[2], on: on, bg: on ? '#F2E415' : '#1C1B13', fg: on ? '#12110C' : '#E4E1B8', bd: on ? '#F2E415' : '#3F3C22', pick: function () { self.setState({ plMood: m[0] }); } }; }),
      plPlats: [['spotify', 'Spotify'], ['deezer', 'Deezer'], ['ytmusic', 'YouTube Music']].map(function (p) { var on = (self.state.plPlat || 'spotify') === p[0]; return { label: p[1], on: on, bg: on ? '#E4E1B8' : 'transparent', fg: on ? '#12110C' : '#E4E1B8', bd: on ? '#E4E1B8' : '#3F3C22', pick: function () { self.setState({ plPlat: p[0] }); } }; }),
      plUrl: (function () { var m = self.state.plMood || 'fun', p = self.state.plPlat || 'spotify'; var key = 'pl' + m.charAt(0).toUpperCase() + m.slice(1) + '_' + p; var d = { spotify: 'https://open.spotify.com/playlist/5Tvk2EIfw5Q4T1HnK63C4d', deezer: 'https://www.deezer.com/', ytmusic: 'https://music.youtube.com/' }; return self.props[key] || (key === 'plChill_spotify' ? 'https://open.spotify.com/playlist/7JabddFr3Q6JPsND4v9Swf' : key === 'plAgressif_spotify' ? 'https://open.spotify.com/playlist/105BF63e6XMWdFjD4s4X0D' : key === 'plFun_spotify' ? 'https://open.spotify.com/playlist/5Tvk2EIfw5Q4T1HnK63C4d' : d[p]); })(),
      plCta: (function () { var m = { fun: 'Fun', agressif: 'Boost', chill: 'Chill' }[self.state.plMood || 'fun']; var p = { spotify: 'Spotify', deezer: 'Deezer', ytmusic: 'YouTube Music' }[self.state.plPlat || 'spotify']; return 'Écouter « ' + m + ' » sur ' + p + ' →'; })(),
      accent: this.props.accent ?? '#F2E415',
      weightStr: this.state.weightStr,
      reps: r,
      oneRm: fmt(max),
      note: note,
      rows: table.map(function (t) { return { pct: t.pct, use: t.use, kg: fmt(max * t.p) }; }),
      wMinus: function () { setW(w - 2.5); },
      wPlus: function () { setW(w + 2.5); },
      onWeight: function (e) { self.setState({ weightStr: e.target.value }); },
      rMinus: function () { self.setState({ reps: Math.max(1, r - 1) }); },
      rPlus: function () { self.setState({ reps: Math.min(15, r + 1) }); }
    };
  }
}
</script>
