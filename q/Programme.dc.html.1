<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 10px"><span style="font-weight: 700; font-size: 18px; color: #F2E415">{{fa.name}}</span><span style="font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #A8A36A">{{fa.role}}</span></div>
<span style="font-size: 15px; line-height: 1.45">{{fa.text}}</span>
<span style="font-size: 14px; line-height: 1.4; color: #D8D4A8"><b style="color: #FFFFFF">On en trouve dans :</b> {{fa.where}}</span>
</div>
</sc-for>
<div style="display: flex; flex-direction: column; gap: 10px; border: 2px solid #807C3A; border-radius: 16px; padding: 16px">
<span style="font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #F2E415">Quiz · Devine la famille</span>
<span style="font-size: 15px">Touche un aliment pour voir la réponse. Score : {{quizSeen}} / {{quizTotal}} découverts.</span>
<sc-for list="{{quiz}}" as="qz" hint-placeholder-count="8">
<div style="display: flex; flex-direction: column; background: #12110C; border: 1px solid #3F3C22; border-radius: 10px; overflow: hidden">
<button onClick="{{qz.toggle}}" aria-expanded="{{qz.open}}" style="display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 52px; padding: 10px 14px; background: transparent; border: 0; text-align: left; cursor: pointer; color: #FFFFFF; font-family: 'Roboto Condensed', sans-serif"><span style="font-size: 17px; font-weight: 700">{{qz.food}}</span><span style="font-size: 14px; font-weight: 700; color: #A8A36A">{{qz.hint}}</span></button>
<sc-if value="{{qz.open}}" hint-placeholder-val="{{ false }}">
<div style="display: flex; flex-direction: column; gap: 6px; padding: 0 14px 12px">
<span style="align-self: flex-start; background: #F2E415; color: #12110C; font-weight: 700; font-size: 13px; padding: 3px 8px; border-radius: 6px">{{qz.tag}}</span>
<span style="font-size: 15px; line-height: 1.45; color: #E4E1B8">{{qz.text}}</span>
</div>
</sc-if>
</div>
</sc-for>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-size: 17px; font-weight: 700; color: #FFFFFF">Ta journée type</span>
<sc-for list="{{nr.day}}" as="d" hint-placeholder-count="4">
<div style="display: flex; flex-direction: column; gap: 3px; border-top: 1px solid #3F3C22; padding-top: 10px"><span style="font-weight: 700; font-size: 16px; color: #F2E415">{{d.meal}}</span><span style="font-size: 15px; line-height: 1.45">{{d.text}}</span></div>
</sc-for>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 17px; font-weight: 700; color: #FFFFFF">Autour de l'entraînement</span>
<sc-for list="{{nr.training}}" as="t" hint-placeholder-count="3">
<div style="display: flex; gap: 10px; align-items: flex-start"><span aria-hidden="true" style="width: 8px; height: 8px; margin-top: 7px; flex-shrink: 0; background: #F2E415; border-radius: 2px"></span><span style="font-size: 15px; line-height: 1.45">{{t.text}}</span></div>
</sc-for>
</div>
<sc-if value="{{nr.hasNotes}}" hint-placeholder-val="{{ true }}">
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 17px; font-weight: 700; color: #FFFFFF">À savoir</span>
<sc-for list="{{nr.notes}}" as="n" hint-placeholder-count="2">
<div style="display: flex; gap: 10px; align-items: flex-start; background: #1C1B13; border-radius: 10px; padding: 12px 14px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F2E415" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="13"></line><line x1="12" y1="16.5" x2="12" y2="16.6"></line></svg><span style="font-size: 15px; line-height: 1.45">{{n.text}}</span></div>
</sc-for>
</div>
</sc-if>
<a href="Suivi.dc.html" style="display: flex; flex-direction: column; gap: 8px; background: #F2E415; color: #12110C; border-radius: 16px; padding: 18px; text-decoration: none">
<span style="font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase">Suivi personnalisé · Sans engagement</span>
<span style="font-family: Anton, Impact, sans-serif; font-size: 28px; line-height: 1.05; text-transform: uppercase">Sport + diététique, suivis</span>
<span style="font-size: 15px; line-height: 1.4">Retours sur tes repas, plan ajusté chaque semaine. Arrête quand tu veux, gratuitement.</span>
<span style="font-weight: 700; font-size: 17px">Voir les formules →</span>
