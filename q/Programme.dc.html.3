          var sel = self.state.n[d.k] === oi;
          return { label: o[0], bg: sel ? '#F2E415' : '#FFFFFF', fg: '#12110C', bd: sel ? '#12110C' : '#C9C49A', pick: function () { var n = Object.assign({}, self.state.n); n[d.k] = oi; self.setState({ n: n, err: '' }); } };
        }) };
      }),
      nr: s === 7 ? this.computeNutri() : { strengths: [], prios: [], macros: [], day: [], training: [], notes: [], hasNotes: false, hasStrengths: false, hasPrios: false },
      showProgress: s >= 1 && s <= 4, showNav: s >= 1 && s <= 4,
      stepLabel: labels[s], stepCount: 'Étape ' + s + ' / 4', progressW: (s * 25) + '%',
      nextLabel: s === 4 ? 'Voir ma préparation' : 'Suivant',
      err: this.state.err, hasErr: !!this.state.err,
      next: function () { go(1); }, back: function () { go(-1); },
      restart: function () { self.setState({ step: 1, openIdx: 0, err: '' }); },
      auditNums: this.nums([{ k: 'age', label: 'Âge', unit: 'ans', min: 10, max: 90, step: 1 }, { k: 'taille', label: 'Taille', unit: 'cm', min: 130, max: 220, step: 1 }, { k: 'poids', label: 'Poids', unit: 'kg', min: 35, max: 180, step: 1 }]),
      testNums: this.nums([{ k: 'pompes', label: '1. Pompes d’affilée', unit: '', min: 0, max: 100, step: 1, desc: 'Corps gainé, poitrine près du sol. Tu t’arrêtes dès que la technique lâche.' }, { k: 'gainage', label: '2. Planche', unit: 's', min: 0, max: 300, step: 5, desc: 'Sur les avant-bras, dos droit. On arrête quand les fesses tombent ou montent.' }]),
      setAge: setter('age'), setTaille: setter('taille'), setPoids: setter('poids'), setPompes: setter('pompes'), setGainage: setter('gainage'),
      sexeOpts: this.opts('sexe', [{ v: 'H', label: 'Homme' }, { v: 'F', label: 'Femme' }]),
      niveauOpts: this.opts('niveau', [{ v: 0, label: 'Sédentaire', sub: 'Pas de sport régulier en ce moment.' }, { v: 1, label: 'Occasionnel', sub: '1 fois par semaine, quand j’y pense.' }, { v: 2, label: 'Régulier', sub: '2 à 3 séances par semaine.' }, { v: 3, label: 'Confirmé', sub: '4 séances ou plus, depuis plus d’un an.' }]),
      courseOpts: this.opts('course', [{ v: 0, label: 'Moins de 10 min' }, { v: 1, label: '10 à 30 min' }, { v: 2, label: '30 min à 1 h' }, { v: 3, label: 'Plus d’1 h' }]),
      goalOpts: this.opts('goal', [{ v: 'semi', family: 'Endurance', label: 'Semi-marathon', sub: '21,1 km sur route.' }, { v: 'marathon', family: 'Endurance', label: 'Marathon', sub: '42,2 km. Le mythe.' }, { v: 'trail', family: 'Endurance', label: 'Trail', sub: 'Nature, dénivelé, cailloux.' }, { v: 'masse', family: 'Musculation', label: 'Masse musculaire', sub: 'Prendre du muscle, proprement.' }, { v: 'explo', family: 'Performance', label: 'Explosivité', sub: 'Détente, vitesse, puissance.' }, { v: 'force', family: 'Musculation', label: 'Force pure', sub: 'Squat, développé couché, soulevé de terre.' }, { v: 'fessiers', family: 'Musculation', label: 'Fessiers & tonicité', sub: 'Des fessiers plus forts et plus galbés.' }, { v: 'silhouette', family: 'Bien-être', label: 'Silhouette', sub: 'Un corps plus tonique et affiné.' }, { v: 'forme', family: 'Bien-être', label: 'Remise en forme', sub: 'Se sentir bien dans son corps.' }]),
      xpOpts: this.opts('xp', [{ v: 0, label: 'Jamais fait de musculation' }, { v: 1, label: 'Un peu, il y a longtemps ou de temps en temps' }, { v: 2, label: 'Régulièrement' }]),
      precOpts: this.multi('prec', [{ v: 'aucune', label: 'Aucune' }, { v: 'dos', label: 'Dos' }, { v: 'genoux', label: 'Genoux' }, { v: 'epaules', label: 'Épaules' }, { v: 'perinee', label: 'Périnée, fuites' }, { v: 'osteo', label: 'Ostéoporose' }, { v: 'grossesse', label: 'Grossesse < 1 an' }], 'aucune'),
      dureeOpts: this.opts('duree', [{ v: 20, label: '20 min' }, { v: 40, label: '40 min' }, { v: 60, label: '60 min' }]),
      lieuOpts: this.opts('lieu', [{ v: 'maison', label: 'Maison' }, { v: 'salle', label: 'Salle' }, { v: 'deux', label: 'Les deux' }]),
      matOpts: this.multi('mat', [{ v: 'halteres', label: 'Haltères' }, { v: 'elastique', label: 'Élastique' }, { v: 'barre', label: 'Barre et banc' }, { v: 'rien', label: 'Rien pour l’instant' }], 'rien'),
      prefOpts: this.opts('pref', [{ v: 'chrono', label: 'Au chrono, temps sous tension' }, { v: 'charges', label: 'Aux charges, en ajoutant du poids' }, { v: 'libre', label: 'Pas de préférence' }]),
      freqOpts: this.opts('freq', [{ v: 1, label: '1', sub: 'séance' }, { v: 2, label: '2', sub: 'séances' }, { v: 3, label: '3', sub: 'séances' }, { v: 4, label: '4', sub: 'séances' }, { v: 5, label: '5', sub: 'séances' }, { v: 6, label: '6', sub: 'séances' }]),
      r: s === 5 ? this.compute() : { notes: [], phases: [], sessions: [], prog: [], hasNotes: false }
    };
  }
}
</script>
